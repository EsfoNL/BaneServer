<!DOCTYPE html>
<html>
	<head>
		<title>Admin page of doom</title>
		<link rel="stylesheet" href="asset/pico.css" type="text/css">
		<script>
		</script>
		<script defer src="/asset/admin.js" type="module"></script>
		<link rel="stylesheet" href="/asset/admin.css">
	</head>

	<body>
		<div class="container relative">
			<h1>Plumbing</h1>
			<button id="start" class="inline">Start</button>
			<button id="stop" class="inline">Stop</button>
			<button id="restart" class="inline">Restart</button>
			<h1>Uploads</h1>
			<div class="twocolumn">
				<div>
					<h2>Mission</h2>
					<input class="inline" id="mission" type="file">
					<button id="mission_button">Submit</button>
					<div id="mission_progress" class="upload_block" hidden>
						<h6>Uploading</h6>
						<progress value="0.1" max="100"></progress>
					</div>
				</div>
				<div>
					<h2>Modpack</h2>
					<input class="inline" id="modpack" type="file">
					<button id="modpack_button">Submit</button>
					<div id="modpack_progress" class="upload_block" hidden>
						<h6>Uploading</h6>
						<progress value="0.1" max="100"></progress>
					</div>
				</div>
			</div>
			<h1>Server Info</h1>
			<div class="twocolumn length-300">
				<div>
					<h2>Players<div id="blinkenlight" class="blinkenlight">●</div></h2>
					<div id="players" class="block">
						{% for player in players %}
						{{ player.name }}<br>
						{% endfor %}
					</div>
				</div>
				<div>
					<h2>Mods</h2>
					<ul class="scroll block">
						{% for mod in (arma_rules.mods) %}
						<li>{{ mod.name }}</li>
						{% endfor %}
					</ul>
				</div>
			</div>
			<h1>Logs<div id="blinkenlight-logs" class="blinkenlight">●</div></h1>
			<div id="logs" class="container block">
			</div>
		</div>
	</body>
</html>
