<!DOCTYPE html>
<html>
	<head>
		<title>Admin page of doom</title>
		<link rel="stylesheet" href="asset/pico.css" type="text/css">
		<script>
			var ws;
			var bottom = true;
			addEventListener("scroll", (event) => {
				bottom = Math.ceil(window.innerHeight + window.scrollY) >= document.body.offsetHeight;
				})
				addEventListener("DOMContentLoaded", (event) => {
					console.log("loaded");
					let sleep = 1000;
					let onopen = () => {
						// sleep = 1000;
					}
					let onmsg = (m) => {
						logs.innerText += m.data;
						console.log(logs.textContent.length);
						if (logs.textContent.length > 5000) {
							console.log("cull!");
							logs.innerText = logs.innerText.slice(-25000);
						}
						if (bottom) {
							document.documentElement.scrollTop = document.documentElement.scrollHeight;
							<!-- document.scroll(document.innerheight); -->
							<!-- logs.scrollIntoView(false); -->
						}
						};
						let oncls = () =>
						{
							setTimeout(() => {
								ws = new WebSocket("/admin/script/websocket/live-logs?no-initial=true");
								ws.onmessage = onmsg;
								ws.onclose = oncls;
								ws.onopen = onopen;
								sleep = sleep * 2;
								
								console.log("reconnect", sleep);
								}, sleep)
							}
							ws = new WebSocket("/admin/script/websocket/live-logs");
							ws.onmessage = onmsg;
							ws.onclose = oncls;
							ws.onopen = onopen;
							
							logs.textContent = '';
							});
		</script>
		<script defer src="/asset/admin.js"></script>
		<style>
			#logs {
				height: 400px;
				overflow: scroll scroll;
				text-wrap: nowrap;
			}
			.inline {
				display: inline;
			}
			.upload_block {
				display: inline-block;
				position: absolute;
				right: 20%;
				width: 50%;
			}
			.relative {
				position: relative;
			}
		</style>
	</head>

	<body>
		<h1>Uploads</h1>
		<div class="container relative">
			<h2>Mission</h2>
			<input class="inline" id="mission" type="file">
			<button id="mission_button">Submit</button>
			<div id="mission_progress" class="upload_block" hidden>
				<h6>Uploading</h6>
				<progress value="0.1" max="100"></progress>
			</div>
		</div>
		<div class="container relative">
			<h2>Modpack</h2>
			<input class="inline" id="modpack" type="file">
			<button id="modpack_button">Submit</button>
			<div id="modpack_progress" class="upload_block" hidden>
				<h6>Uploading</h6>
				<progress value="0.1" max="100"></progress>
			</div>
		</div>
		<h1>Logs</h1>
		<div id="logs" class="container">
		</div>
		<div id="anchor"></div>
	</body>
</html>
